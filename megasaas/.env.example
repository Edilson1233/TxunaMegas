# Identificação da instância (útil já pensando em multi-tenancy futura)
NODE_ENV=development
LOG_LEVEL=info

# Pasta onde a sessão do WhatsApp (Baileys) é persistida
WHATSAPP_AUTH_DIR=./storage/auth

# Nome/etiqueta desta instância de WhatsApp (1 número = 1 instância nesta fase)
WHATSAPP_INSTANCE_ID=default-instance

# --- Tasker (Fase 5) ---
# Token partilhado que o dispositivo Tasker deve enviar como
# "Authorization: Bearer <TASKER_API_KEY>". Gera um valor aleatório forte
# antes de ligar isto à internet pública (ex: openssl rand -hex 32).
TASKER_API_KEY=meu_segredo
# Porta onde o servidor HTTP do Tasker fica à escuta.
TASKER_PORT=3001

# Tabela temporaria para testes locais antes dos pacotes/precos editaveis
# viverem no Spring Core. Formato: valorPagoMT:megasParaDigitarNoUSSD.
# Ex: 15MT pagos => MacroDroid deve digitar 600 no USSD.
PACKAGE_PRICE_TABLE=15:600,30:1200

# --- Spring Core (opcional neste passo) ---
# Se CORE_API_BASE_URL ficar vazio/ausente, o Node continua a usar o fluxo
# antigo em memoria para pagamentos. Ao definir estes valores, o Node passa a
# delegar claims e confirmacoes SMS para o Spring Core por REST autenticado.
# CORE_API_BASE_URL=http://localhost:8080
# CORE_INTERNAL_API_TOKEN=test-token
# CORE_TENANT_ID=11111111-1111-1111-1111-111111111111
# TASKER_DEVICE_ID=22222222-2222-2222-2222-222222222222
